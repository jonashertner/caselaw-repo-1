    given-names: Jonas
    email: jh@jonashertner.com
repository-code: "https://github.com/jonashertner/caselaw-repo-1"
url: "https://opencaselaw.ch"
license: MIT
keywords:
  - Swiss law
  - case law
  - legal research
  - citation graph
  - legal NLP
  - Model Context Protocol
  - open data
