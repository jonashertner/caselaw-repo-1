[Unit]
Description=OpenCaseLaw daily ECtHR (HUDOC) incremental top-off
After=network.target
# Skip if the initial backfill transient unit is still running, or if
# a previous run is somehow still active.
ConditionPathExists=/opt/caselaw/repo/state/ecthr.jsonl

[Service]
Type=oneshot
WorkingDirectory=/opt/caselaw/repo
# Do nothing if the one-shot backfill is still active. The transient
# `opencaselaw-ecthr-backfill.service` lives only while backfilling;
# once it exits, this condition passes and the top-off runs.
ExecStartPre=/bin/bash -c '! systemctl is-active --quiet opencaselaw-ecthr-backfill.service'
# Scrape, then atomic-publish into FTS5 so the new decisions are
# searchable within minutes — without this chain the JSONL got
# written daily but the FTS5 DB only updated at the nightly 03:00 UTC
# publish, leaving the user-visible API up to 24 h stale on the very
# kind of fresh-ECHR query the timer is meant to service.
ExecStart=/bin/bash -c '\
    /usr/bin/python3 /opt/caselaw/repo/run_scraper.py ecthr && \
    /usr/bin/python3 /opt/caselaw/repo/scripts/quick_publish.py \
        --courts ecthr_chamber,ecthr_committee,ecthr_grand_chamber,hudoc_ch'
TimeoutStartSec=5400
StandardOutput=append:/opt/caselaw/repo/logs/ecthr_daily.log
StandardError=append:/opt/caselaw/repo/logs/ecthr_daily.log
