[Unit]
Description=OpenCaseLaw publish pipeline (full rebuild)
# Deliberately NOT After=opencaselaw-scrape.service. That is a job-ordering
# dependency, and because the scrape is Type=oneshot its start job stays
# "running" for the whole scrape, so the timer's start job for this unit was
# held in the queue with no log line and no time bound (2026-08-28: 37 min;
# 2026-09-04: 2h18m, until vd_gerichte hit its 4h cap; 2026-09-05: 2h06m).
# The ExecStartPre loop below is the bounded, logged version of the same wait.
After=network.target

[Service]
Type=oneshot
WorkingDirectory=/opt/caselaw/repo
# Wait up to 2h for the scrape to finish before starting, then proceed anyway
# (run_scraper appends and flushes per decision; build_fts5 skips a torn last
# line). A oneshot that is still running reports ActiveState=activating and
# `systemctl is-active` exits 3 for it, so test ActiveState explicitly.
ExecStartPre=/bin/bash -c "for i in $(seq 1 240); do systemctl show -p ActiveState --value opencaselaw-scrape.service | grep -qxE 'active|activating|reloading|deactivating' || exit 0; echo \"Waiting for opencaselaw-scrape.service to finish ($$i/240, 30 s)...\"; sleep 30; done; echo \"WARNING: scrape still running after 2h, proceeding anyway\""
ExecStart=/usr/bin/python3 publish.py --full-rebuild
EnvironmentFile=/opt/caselaw/repo/.env.publish
# Resource fence (2026-07-06): keep the nightly build from starving the 8
# serving workers when a long build overlaps daytime traffic (root cause of
# the 2026-07-04 WAL thrashing + 07-06 export slowdown / watchdog-killed aux
# steps). On the 16-core box: cap the whole build cgroup (publish.py + all
# child steps) to 8 cores so serving always keeps 8; soft weights make the
# build yield further under contention while still using idle capacity at
# night. Applies at the NEXT build start (daemon-reload does not disturb a
# running build). Reversible.
CPUQuota=800%
CPUWeight=60
IOWeight=50
TimeoutStartSec=28800
StandardOutput=append:/opt/caselaw/repo/logs/publish.log
StandardError=append:/opt/caselaw/repo/logs/publish.log
# Prevent concurrent publish runs
ExecCondition=/bin/bash -c "! systemctl is-active --quiet opencaselaw-publish.service"
