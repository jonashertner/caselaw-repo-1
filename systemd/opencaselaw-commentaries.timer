[Unit]
Description=Weekly scholarly commentaries resync (Mondays, after the crawl window)

[Timer]
# Weekly since 2026-08-22 (was monthly on the 2nd). The whole OnlineKommentar
# corpus is ~390 commentaries — a full resync is minutes of polite API calls —
# while a monthly cadence left newly published commentaries invisible for up
# to four weeks. 13:00 UTC keeps clear of the cantonal crawl's ~4h window
# (07:00-11:00 UTC) so nothing competes for bandwidth.
OnCalendar=Mon *-*-* 13:00:00 UTC
Persistent=true
RandomizedDelaySec=600

[Install]
WantedBy=timers.target
